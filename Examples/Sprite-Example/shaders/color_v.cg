// Position and a colour per vertex.
// Matrices arrive in column-major memory order (as Odin and OpenGL store
// them), which Cg reads as the transpose; hence mul(vector, matrix).
void main(
    float3 aPosition,
    float4 aColor,
    uniform float4x4 uMvp,
    out float4 vPosition : POSITION,
    out float4 vColor : COLOR0)
{
    vPosition = mul(float4(aPosition, 1.f), uMvp);
    vColor = aColor;
}
