// One directional light plus ambient light (Lambert shading).
float4 main(
    float3 vNormal : TEXCOORD0,
    float2 vTexcoord : TEXCOORD1,
    uniform sampler2D uTexture,
    uniform float3 uLightDirection,   // points from the surface towards the light
    uniform float3 uLightColor,
    uniform float3 uAmbient) : COLOR
{
    float3 n = normalize(vNormal);
    float diffuse = max(dot(n, normalize(uLightDirection)), 0.f);
    float4 base = tex2D(uTexture, vTexcoord);
    return float4(base.rgb * (uAmbient + uLightColor * diffuse), base.a);
}
