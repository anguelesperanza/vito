// Points: position, colour, and a size in pixels per vertex.
void main(
    float3 aPosition,
    float4 aColor,
    float aSize,
    uniform float4x4 uMvp,
    out float4 vPosition : POSITION,
    out float4 vColor : COLOR0,
    out float vSize : PSIZE)
{
    vPosition = mul(float4(aPosition, 1.f), uMvp);
    vColor = aColor;
    vSize = aSize;
}
