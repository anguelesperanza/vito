// Instancing: aPosition and aColor come once per vertex, aOffset and aTint
// once per instance (a second vertex stream).
void main(
    float3 aPosition,
    float4 aColor,
    float4 aOffset,   // xyz: where the instance is, w: its size
    float4 aTint,
    uniform float4x4 uMvp,
    uniform float uTime,
    out float4 vPosition : POSITION,
    out float4 vColor : COLOR0)
{
    // Each instance turns about the y axis at its own phase.
    float angle = uTime + aOffset.x * 0.7 + aOffset.y * 0.5;
    float s = sin(angle);
    float c = cos(angle);
    float3 p = aPosition * aOffset.w;
    float3 turned = float3(p.x * c + p.z * s, p.y, p.z * c - p.x * s);
    vPosition = mul(float4(turned + aOffset.xyz, 1.f), uMvp);
    vColor = aColor * aTint;
}
